# Agent Sentinel - example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All values below are placeholders/examples only.

# --- Application ---
ENVIRONMENT=development
# Use sqlite for quick local dev, or postgres for closer-to-prod:
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/agent_sentinel
ENABLE_DEMO_SEED=true
RATE_LIMIT_PER_MINUTE=240
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secrets (GENERATE STRONG RANDOM VALUES for any non-local deployment) ---
# Random pepper mixed into API-key hashes. Use a long random string.
API_KEY_PEPPER=change-me-with-a-long-random-value
# Required for all admin/agent-registration endpoints. Must be set in production.
ADMIN_API_KEY=change-me-admin-key
# Secret used to sign JWTs. MUST be set to a strong random value in production
# (startup will fail without it when ENVIRONMENT=production).
JWT_SECRET_KEY=change-me-with-a-long-random-value

# --- SDK fail-closed behavior ---
# When true, the Python SDK blocks tool calls if the enforcement API is unreachable.
SENTINEL_FAIL_CLOSED=true

# --- JWT lifetimes (optional) ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth (Sign in with Google) ---
# Obtain these from Google Cloud Console > APIs & Services > Credentials.
# These are secrets - store them here in .env only, never in docker-compose.yml or git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# --- Frontend ---
VITE_API_BASE=http://localhost:8000/api/v1

# --- Optional analytics profile services (set only if you enable the `analytics` profile) ---
# NEO4J_AUTH=neo4j/your-password
# OPENSEARCH_INITIAL_ADMIN_PASSWORD=YourStrongPassword123!
