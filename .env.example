# Agent Sentinel local-development example.
# Copy this file to .env. Never put real production secrets in a repository file.

# Application mode
ENVIRONMENT=development
ENABLE_DEMO_SEED=false
AGENT_SENTINEL_ALLOW_OPEN_REGISTER=true

# The Compose stack uses its PostgreSQL service and POSTGRES_PASSWORD below.
# DATABASE_URL is used when running the backend directly. SQLite is convenient
# for a local process, but production startup rejects it; use PostgreSQL there.
# postgresql+psycopg://agent_sentinel:<password>@<host>:5432/agent_sentinel
DATABASE_URL=sqlite:///./agent_sentinel.db
POSTGRES_PASSWORD=change-me-development-postgres-password

# Redis backs rate limiting and Celery transport/results in the local topology.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240

# Development placeholders only. Generate separate high-entropy values and
# inject them from a secret manager in every non-local environment.
JWT_SECRET_KEY=change-me-development-jwt-secret
API_KEY_PEPPER=change-me-development-api-key-pepper
ADMIN_API_KEY=change-me-development-admin-key

# High-risk SDK clients should construct AgentSentinelClient with
# fail_closed=True. This backend setting also makes production enforcement
# requests fail closed when the Redis rate-limit dependency is unavailable.
SENTINEL_FAIL_CLOSED=true

# Browser session lifetime
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Exact browser origins only; do not use '*' with credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE=http://localhost:8000/api/v1

# Google OAuth is disabled when these credentials are empty. The callback URL
# must exactly match a redirect URI configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Leave empty for localhost. Production cookie deployments may set the shared
# parent domain, for example .example.com, after reviewing subdomain trust.
COOKIE_DOMAIN=

# Experimental secondary-store integrations. Local Compose exposes these with
# development settings; they are not required for primary SQL API behavior.
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/change-me-development-password
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-development-password
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CA_CERTS=
